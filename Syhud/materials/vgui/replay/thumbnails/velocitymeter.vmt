"UnlitGeneric"
{
	 "$baseTexture" "vgui\replay\thumbnails\velocitymeter"
	"$translucent" 1
	"$vertexcolor" 1
	"$no_fullbright" 1
	"$ignorez" 1
	"$speed" 0
	"$alpha" "1"
	Proxies {
		PlayerSpeed {
			scale 0.2
			resultVar $speed
		}
		Clamp {
			min 0
			max 149
			srcVar1 $speed
			resultVar $frame
		}
	}
}
