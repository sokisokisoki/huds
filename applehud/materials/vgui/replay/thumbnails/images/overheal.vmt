"UnlitGeneric"
{
	"$basetexture"	"vgui\replay\thumbnails\images\overheal"
	"$translucent" "0"//1
	"$ignorez" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	
	
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedTextureVar" "$basetexture"
			"animatedTextureFrameNumVar" "$frame"
			"animatedTextureFrameRate" "33"
		}
	}
}